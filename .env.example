# Environment variables for Amigos Hub CMS

# ── CMS Admin Password ────────────────────────────────────────────────────────
# Required: Set this to a strong secret before deploying.
# The /dashboard-x7k2 route will show a 500 error if this is unset.
# Rotating this value instantly invalidates all existing admin sessions.
CMS_ADMIN_PASSWORD=change-me-before-deploying

# ── Optional ──────────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by the runtime (development / production).
# In production, the session cookie gains the Secure flag automatically.
